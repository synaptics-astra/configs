# MUST know before modifying this partition table:
# 1. need to apply factory flow patch that provided by Synaptics.
# 2. emmc write protection feature would not be enabled.
#layout         partition_name          erase/format    first action    write_protection
16M@16M         factory_setting         default         default         none
1M              key_a                   default         default         none
7M              fastboot_a              erase           default         none
8M              tzk_a                   default         default         none
8M              sysmgr_a                default         default         none
1M              key_b                   default         default         none
7M              fastboot_b              erase           default         none
8M              tzk_b                   default         default         none
8M              sysmgr_b                default         default         none
8M              bl_a                    default         default         none
8M              bl_b                    default         default         none
16M             fastlogo_a              default         default         none
16M             fastlogo_b              default         default         none
64M             boot_a                  default         default         none
64M             boot_b                  default         default         none
8M              init_boot_a             default         default         none
8M              init_boot_b             default         default         none
64M             vendor_boot_a           default         default         none
64M             vendor_boot_b           default         default         none
64M             vendor_kernel_boot_a    default         default         none
64M             vendor_kernel_boot_b    default         default         none
8M              dtbo_a                  erase           default         none
8M              dtbo_b                  erase           default         none
1M              vbmeta_a                default         default         none
1M              vbmeta_b                default         default         none
1M              vbmeta_system_a         default         default         none
1M              vbmeta_system_b         default         default         none
5648M           super                   default         default         none
2M              misc                    erase           default         none
4M              devinfo                 erase           default         none
64M             metadata                erase           default         none
8M              frp                     erase           default         none
32M             firmware_a              default         default         none
32M             firmware_b              default         default         none
-               userdata                erase           default         none
